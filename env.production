# PRODUCTION ENVIRONMENT CONFIGURATION
# This profile is for production deployment with real data and live trading.
# ALL SECRETS MUST BE PROVIDED VIA SECURE METHODS (vault, secrets manager, etc.)
# DO NOT commit real secrets to version control.

# API Endpoints - Update with your production backend URL
VITE_API_BASE=https://api.yourdomain.com
VITE_WS_BASE=wss://api.yourdomain.com

# Data Policy - Real Data Only (strict enforcement)
VITE_APP_MODE=online
VITE_STRICT_REAL_DATA=true
VITE_USE_MOCK_DATA=false
VITE_ALLOW_FAKE_DATA=false

# Hugging Face API Key - INJECT VIA SECRETS MANAGER
HF_TOKEN=
HUGGINGFACE_API_KEY=

# Server Configuration
PORT=8001
NODE_ENV=production

# Primary Data Source
PRIMARY_DATA_SOURCE=huggingface
HF_ENGINE_BASE_URL=https://really-amin-datasourceforcryptocurrency.hf.space
HF_ENGINE_ENABLED=true

# Proxy Configuration - Only for Binance (if needed in production)
# HTTP_PROXY=http://proxy.production.com:8080
# HTTPS_PROXY=http://proxy.production.com:8080
# USE_GLOBAL_PROXY_FOR_BINANCE=false

# API Provider Priority
ENABLE_CMC=false
CMC_API_KEY=

# Backend Configuration - Production optimized
START_INGEST_ON_BOOT=false
ENABLE_INGEST_CRON=false
WATCHED_SYMBOLS=BTC,ETH,XRP,SOL,ADA
STARTUP_INTERVALS=15m,1h
STARTUP_HIST_LIMIT=500
DISABLE_NEWS=false
DISABLE_SENTIMENT=false

# Frontend Configuration
VITE_WS_CONNECT_ON_START=false
VITE_DISABLE_INITIAL_LOAD=true
VITE_REFRESH_MS=60000

# Resilience/Fallback - Production hardened
AXIOS_MAX_RETRIES=5
BOOT_NO_RETRY=false
BOOT_PRIMARY_ONLY=true
BOOT_WINDOW_MS=180000

# Exchange Configuration - MAINNET (inject secrets securely)
KUCOIN_FUTURES_KEY=
KUCOIN_FUTURES_SECRET=
KUCOIN_FUTURES_PASSPHRASE=
FUTURES_BASE_URL=https://api-futures.kucoin.com

# Redis Configuration (if used in production)
DISABLE_REDIS=false
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# Monitoring & Observability
LOG_LEVEL=info
ENABLE_METRICS=true
ENABLE_TRACING=false

# Security
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
