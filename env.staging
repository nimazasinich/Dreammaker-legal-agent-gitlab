# STAGING ENVIRONMENT CONFIGURATION
# This profile is for staging/pre-production testing with real data sources
# but in a controlled, test-like environment.

# API Endpoints - Update with your staging backend URL
VITE_API_BASE=http://staging.yourdomain.com:8001
VITE_WS_BASE=ws://staging.yourdomain.com:8001

# Data Policy - Real Data Only (strict enforcement)
VITE_APP_MODE=online
VITE_STRICT_REAL_DATA=true
VITE_USE_MOCK_DATA=false
VITE_ALLOW_FAKE_DATA=false

# Hugging Face API Key - REPLACE WITH YOUR STAGING KEY
HF_TOKEN=YOUR_STAGING_HF_TOKEN_HERE
HUGGINGFACE_API_KEY=YOUR_STAGING_HF_TOKEN_HERE

# Server Configuration
PORT=8001
NODE_ENV=staging

# Primary Data Source
PRIMARY_DATA_SOURCE=huggingface
HF_ENGINE_BASE_URL=https://really-amin-datasourceforcryptocurrency.hf.space
HF_ENGINE_ENABLED=true

# Proxy Configuration - Only for Binance (if needed)
# HTTP_PROXY=http://proxy.staging.com:8080
# HTTPS_PROXY=http://proxy.staging.com:8080
# USE_GLOBAL_PROXY_FOR_BINANCE=false

# API Provider Priority
ENABLE_CMC=false
CMC_API_KEY=

# Backend Configuration - Conservative for staging
START_INGEST_ON_BOOT=false
ENABLE_INGEST_CRON=false
WATCHED_SYMBOLS=BTC,ETH
STARTUP_INTERVALS=15m
STARTUP_HIST_LIMIT=200
DISABLE_NEWS=true
DISABLE_SENTIMENT=true

# Frontend Configuration
VITE_WS_CONNECT_ON_START=false
VITE_DISABLE_INITIAL_LOAD=true
VITE_REFRESH_MS=120000

# Resilience/Fallback
AXIOS_MAX_RETRIES=3
BOOT_NO_RETRY=false
BOOT_PRIMARY_ONLY=false
BOOT_WINDOW_MS=120000

# Exchange Configuration - TESTNET ONLY for staging
KUCOIN_FUTURES_KEY=YOUR_STAGING_KUCOIN_KEY
KUCOIN_FUTURES_SECRET=YOUR_STAGING_KUCOIN_SECRET
KUCOIN_FUTURES_PASSPHRASE=YOUR_STAGING_KUCOIN_PASSPHRASE
FUTURES_BASE_URL=https://api-sandbox-futures.kucoin.com
