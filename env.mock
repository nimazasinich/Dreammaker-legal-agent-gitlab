HUGGINGFACE_API_KEY=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

# Server Configuration
PORT=3001
NODE_ENV=development

# Primary Data Source (configured but not used in demo mode)
PRIMARY_DATA_SOURCE=huggingface
HF_ENGINE_BASE_URL=https://really-amin-datasourceforcryptocurrency.hf.space
HF_ENGINE_ENABLED=true

# Proxy Configuration - Only for Binance
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# USE_GLOBAL_PROXY_FOR_BINANCE=false

# API Provider Priority
ENABLE_CMC=false
CMC_API_KEY=

# Backend – throttle at boot
START_INGEST_ON_BOOT=false
ENABLE_INGEST_CRON=false
WATCHED_SYMBOLS=BTC,ETH
STARTUP_INTERVALS=15m
STARTUP_HIST_LIMIT=200
DISABLE_NEWS=true
DISABLE_SENTIMENT=true

# Frontend – no auto-connect, no initial mega-prefetch
VITE_WS_CONNECT_ON_START=false
VITE_DISABLE_INITIAL_LOAD=true
VITE_REFRESH_MS=120000

# Resilience/Fallback
AXIOS_MAX_RETRIES=3
BOOT_NO_RETRY=false
BOOT_PRIMARY_ONLY=false
BOOT_WINDOW_MS=120000
