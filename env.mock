VITE_WS_BASE=ws://localhost:8001

# Data Policy - Mock/Demo Mode (explicit opt-in)
VITE_APP_MODE=demo
VITE_STRICT_REAL_DATA=false
VITE_USE_MOCK_DATA=true
VITE_ALLOW_FAKE_DATA=false

