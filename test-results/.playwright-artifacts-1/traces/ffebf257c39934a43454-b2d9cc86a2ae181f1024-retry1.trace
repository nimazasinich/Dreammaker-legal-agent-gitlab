-accent-blue-glow: 37, 99, 235;\n  --accent-purple: rgb(139, 92, 246);\n  --accent-purple-glow: 139, 92, 246;\n  --accent-cyan: rgb(6, 182, 212);\n  --accent-cyan-glow: 6, 182, 212;\n  --accent-pink: rgb(236, 72, 153);\n  --accent-pink-glow: 236, 72, 153;\n  --success-glow: 22, 163, 74;\n  --error-glow: 220, 38, 38;\n  --warning-glow: 217, 119, 6;\n\n  /* Spacing */\n  --radius: 14px;\n  --radius-lg: 16px;\n  --radius-xl: 20px;\n  --gap: 16px;\n  --gap-sm: 12px;\n  --gap-lg: 24px;\n\n  /* Shadows - lighter for light theme */\n  --shadow-sm: 0 4px 16px rgba(15, 23, 42, 0.08);\n  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.12);\n  --shadow-lg: 0 12px 40px rgba(15, 23, 42, 0.15);\n  --shadow-card-soft: 0 6px 30px rgba(15, 23, 42, 0.08);\n\n  /* Surface variations */\n  --surface-muted: rgba(241, 245, 249, 0.8); /* slate-100 with transparency */\n  --card-border: rgba(15, 23, 42, 0.08);\n  --card-border-hover: rgba(15, 23, 42, 0.15);\n}\n\n@keyframes shimmer {\n  0% {\n    background-position: -1000px 0;\n  }\n  100% {\n    background-position: 1000px 0;\n  }\n}\n\n.animate-shimmer {\n  animation: shimmer 8s infinite linear;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    rgba(255, 255, 255, 0.03) 50%,\n    transparent 100%\n  );\n  background-size: 1000px 100%;\n}\n\n.card {\n  background: var(--glass);\n  border: 1px solid var(--border);\n  box-shadow: var(--shadow);\n  border-radius: 14px;\n  backdrop-filter: blur(10px);\n}\n\n.card-base {\n  background: var(--glass);\n  border: 1px solid var(--border);\n  box-shadow: var(--shadow);\n  border-radius: var(--radius-lg);\n  backdrop-filter: blur(10px);\n}\n\n.card-hover {\n  transition: all 0.3s ease;\n}\n\n.card-hover:hover {\n  border-color: var(--card-border-hover);\n  transform: scale(1.02);\n}\n\n/* Badge styles */\n.badge {\n  font-weight: 600;\n  padding: 0.25rem 0.5rem;\n  border-radius: 0.5rem;\n  font-size: 0.875rem;\n}\n\n.badge-ok {\n  background: #dcfce7;\n  color: #166534;\n}\n\n.badge-warn {\n  background: #fef3c7;\n  color: #92400e;\n}\n\n.badge-error {\n  background: #fee2e2;\n  color: #991b1b;\n}\n\n/* Button styles */\n.btn-ghost {\n  border: 1px solid var(--border);\n  background: var(--card);\n  border-radius: 10px;\n  padding: 0.5rem 1rem;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.btn-ghost:hover {\n  border-color: var(--brand);\n  background: var(--surface);\n}\n\n.btn-ghost:focus {\n  outline: 2px solid var(--brand);\n  outline-offset: 2px;\n}\n\n.btn-ghost:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.btn-primary {\n  background: var(--brand);\n  color: white;\n  border: none;\n  border-radius: 10px;\n  padding: 0.5rem 1rem;\n  cursor: pointer;\n  font-weight: 600;\n  transition: all 0.2s ease;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.btn-primary:hover {\n  background: var(--primary-700);\n}\n\n.btn-primary:focus {\n  outline: 2px solid var(--brand);\n  outline-offset: 2px;\n}\n\n.btn-primary:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.glow-blue {\n  box-shadow: var(--shadow-lg), 0 0 60px rgba(var(--accent-blue-glow), 0.15);\n}\n\n.glow-purple {\n  box-shadow: var(--shadow-lg),\n    0 0 60px rgba(var(--accent-purple-glow), 0.15);\n}\n\n.glow-cyan {\n  box-shadow: var(--shadow-lg), 0 0 60px rgba(var(--accent-cyan-glow), 0.15);\n}\n\n.glow-success {\n  box-shadow: var(--shadow-lg), 0 0 60px rgba(var(--success-glow), 0.15);\n}\n\n.glow-error {\n  box-shadow: var(--shadow-lg), 0 0 60px rgba(var(--error-glow), 0.15);\n}\n\n.text-glow-blue {\n  text-shadow: 0 0 20px rgba(var(--accent-blue-glow), 0.3);\n}\n\n.text-glow-purple {\n  text-shadow: 0 0 20px rgba(var(--accent-purple-glow), 0.3);\n}\n\n.text-glow-success {\n  text-shadow: 0 0 10px rgba(var(--success-glow), 0.8);\n}\n\n.text-glow-error {\n  text-shadow: 0 0 10px rgba(var(--error-glow), 0.8);\n}\n\n/* Trading tabs - enhanced modern styling */\n.trading-header {\n  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.9) 100%);\n  border: 1px solid rgba(148, 163, 184, 0.1);\n  box-shadow: 0 8px 32px rgba(139, 92, 246, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);\n  backdrop-filter: blur(20px);\n  position: relative;\n  overflow: hidden;\n}\n\n.trading-header::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: linear-gradient(90deg,\n    transparent 0%,\n    var(--primary-400) 20%,\n    var(--primary-600) 50%,\n    var(--primary-400) 80%,\n    transparent 100%\n  );\n  opacity: 0.6;\n}\n\n.trading-tab {\n  position: relative;\n  border: 1px solid transparent;\n  backdrop-filter: blur(10px);\n  -webkit-user-select: none;\n     -moz-user-select: none;\n          user-select: none;\n  cursor: pointer;\n}\n\n.trading-tab:hover {\n  transform: translateY(-1px);\n}\n\n.trading-tab-active {\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  box-shadow: 0 8px 24px rgba(139, 92, 246, 0.35),\n              0 4px 12px rgba(126, 34, 206, 0.25),\n              inset 0 1px 0 rgba(255, 255, 255, 0.2);\n  transform: translateY(-2px);\n}\n\n.trading-tab-active::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  border-radius: inherit;\n  background: linear-gradient(180deg,\n    rgba(255, 255, 255, 0.15) 0%,\n    transparent 50%\n  );\n  pointer-events: none;\n}\n\n/* Trading tabs - legacy support for aria-selected */\n[role=\"tab\"][aria-selected=\"true\"] {\n  background: var(--brand-weak);\n  font-weight: 600;\n}\n\n/* Smooth gradient text animations */\n@keyframes gradient-shift {\n  0%, 100% {\n    background-position: 0% 50%;\n  }\n  50% {\n    background-position: 100% 50%;\n  }\n}\n\n.trading-header h2 {\n  background-size: 200% auto;\n  animation: gradient-shift 8s ease infinite;\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"fixed inset-0 z-50 flex items-center justify-center bg-gradient-to-br from-surface-page via-surface to-surface-muted dark:from-gray-9